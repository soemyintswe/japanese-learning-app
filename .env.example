# Firebase config ကို ဒီမှာ ဖြည့်ပါ (Expo public env)
# ဒီ file ကို copy ကူးပြီး .env လို့ နာမည်ပြောင်းပြီး တကယ့် key ထည့်ပါ
# .env က GitHub ပေါ် တင်လို့မရအောင် .gitignore မှာ ပါပြီးသားပါ
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyBqCZYc1octHkFdym33TYeFmq-7nyGiqLU
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=japanese-mksedu.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=japanese-mksedu
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=japanese-mksedu.firebasestorage.app
EXPO_PUBLIC_FIREBASE_SENDER_ID=310467540365
EXPO_PUBLIC_FIREBASE_APP_ID=1:310467540365:web:c183423b7cb5837d0b79c4

# Google Drive backup (optional — မထည့်ရင် Drive buttons က setup notice ပြမယ်)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID:
#  - Web application: Authorized JS origin https://japanese-mksedu.web.app (+ http://localhost:8081 dev)
#  - OAuth consent: Testing mode + tester emails ထည့် (drive.appdata scope)
#  - Android/iOS client: native build/EAS သုံးမှ လို
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
