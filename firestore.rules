rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ကိုယ့် profile doc ရှိမှ role ကြည့်မယ် — မရှိရင် '' (rule error မဖြစ်အောင်)
    function callerRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : '';
    }
    function isStaff() {
      return isSignedIn() && (callerRole() == 'admin' || callerRole() == 'teacher');
    }

    function isChatMember(chatId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Group creator (moderation) — ကိုယ့်အဖွဲ့ထဲက message/media အကုန် ရှင်းလို့ရ
    function isChatOwner(chatId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/chats/$(chatId)).data.createdBy == request.auth.uid;
    }

    match /users/{userId} {
      // ဖတ်ခွင့်: login ဝင်ထားသူတိုင်း (directory/chat/reports အတွက် list လို)
      // Private profile ကို client ဘက်က ဖျောက်ပြမယ် (field-level rule မဟုတ် — sec HANDOVER)
      allow get, list: if isSignedIn();

      // ဖန်တီးခွင့်: ကိုယ့် uid doc သက်သက် + email က ကိုယ့် Auth email ဖြစ်ရမယ်
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;

      // ပြင်ခွင့်: staff က အကုန် (role/status အပါ);
      // ကိုယ်တိုင် က profile fields (name/phone/birthdate/gender/education/jlpt/bio/photoURL/
      // isPublic/testedLevel/lastSeenAt/lastActiveAt) — role/status ထိမရ
      allow update: if isSignedIn() && (
        isStaff()
        || (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
      );

      // ဖျက်ခွင့်: staff, သို့မဟုတ် ကိုယ့် email နဲ့ doc (placeholder အဟောင်း ရှင်းဖို့)
      allow delete: if isSignedIn() && (
        isStaff()
        || resource.data.email == request.auth.token.email
      );
    }

    // Shared teacher materials (teacher's Drive links) — read all signed-in, write staff
    match /materials/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // Teacher bio card (settings/teacherBio) — read all signed-in, write staff (teacher/admin)
    match /settings/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /chats/{chatId} {
      // member ဝင်ထားသူသာ ဖတ်/စာရင်း (query: where members array-contains own uid)
      // NOTE: DM အသစ် getDoc စစ်တုန်း doc မရှိသေးရင် resource.data = null → deny ဖြစ်မယ်၊
      // ဒါကြောင့် get (မရှိရင် allow) နဲ့ list (member only) ခွဲထားတယ်
      allow get: if isSignedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId))
        || request.auth.uid in resource.data.members
      );
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;
      // ဖန်တီး: ကိုယ် member ပါရမယ် + အနည်းဆုံး 2 ယောက်
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() >= 2;
      // lastMessage/updatedAt update: member
      allow update: if isSignedIn() && request.auth.uid in resource.data.members;
      // ဖျက်: creator သို့မဟုတ် staff
      allow delete: if isSignedIn() && (
        isStaff() || request.auth.uid == resource.data.createdBy
      );

      match /messages/{msgId} {
        allow get, list: if isChatMember(chatId);
        // ပို့: member + byUid က ကိုယ်တိုင် ဖြစ်ရမယ် (edit မရ)
        allow create: if isChatMember(chatId)
          && request.resource.data.byUid == request.auth.uid;
        allow update: if false;
        // ဖျက်: ကိုယ်ပို့ / staff / group creator (moderation)
        allow delete: if isSignedIn() && (
          isStaff() || isChatOwner(chatId)
          || resource.data.byUid == request.auth.uid
        );
      }

      // 🎤 voice + 📎 attachments (audio/file base64 — list query လေးအောင် messages နဲ့ ခွဲထား)
      match /media/{mediaId} {
        allow get, list: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.byUid == request.auth.uid;
        allow update: if false;
        allow delete: if isSignedIn() && (
          isStaff() || isChatOwner(chatId)
          || resource.data.byUid == request.auth.uid
        );
      }
    }
  }
}
